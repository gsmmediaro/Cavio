# ── Kaggle credentials (optional, only needed for kagglehub download) ──
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ── Data directories (override defaults) ──
# DENTEX_DATA_DIR=data/dentex
# BITEWING_DATA_DIR=data/bitewing
# CBCT_DATA_DIR=data/cbct

# ── Cavio web API security / billing (never commit real secrets) ──
# AUTH_REQUIRED=true
# CAVIO_AUTH_SECRET=replace-with-long-random-string
# ALLOW_LOCAL_AUTH=true
# FIREBASE_PROJECT_ID=your-firebase-project-id
# MAX_UPLOAD_BYTES=20971520
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60
# SIGNUP_BONUS_CREDITS=3
# SCAN_CREDIT_COST=1
# CREDITS_PER_PACK=25
# CREDIT_PACK_PRICE_CENTS=1999
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=
# CHECKOUT_SUCCESS_URL=http://localhost:5173/settings?credits=success
# CHECKOUT_CANCEL_URL=http://localhost:5173/settings?credits=cancel
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

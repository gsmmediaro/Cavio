# ── Kaggle credentials (optional, only needed for kagglehub download) ──
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ── Data directories (override defaults) ──
# DENTEX_DATA_DIR=data/dentex
# BITEWING_DATA_DIR=data/bitewing
# CBCT_DATA_DIR=data/cbct

# ── CORS (localhost by default; set exact origins in production) ──
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# Leave empty to disable regex matching (recommended).
# CORS_ORIGIN_REGEX=

# ── Upload / inference abuse limits ──
MAX_UPLOAD_MB=15
MAX_IMAGE_PX=8192
MIN_IMAGE_PX=32
INFERENCE_TIMEOUT_S=45
MAX_CONCURRENT_INFERENCES=2
RESULTS_TTL_HOURS=24

# ── Rate limits (analyze + models listing) ──
RATE_LIMIT_ANALYZE_PER_IP_MINUTE=3
RATE_LIMIT_ANALYZE_PER_IP_DAY=10
RATE_LIMIT_ANALYZE_PER_USER_MINUTE=5
RATE_LIMIT_ANALYZE_PER_USER_DAY=50
RATE_LIMIT_MODELS_PER_IP_MINUTE=30
TRIAL_SCANS_PER_DAY=5

# ── Auth (optional locally; enable in production) ──
# REQUIRE_AUTH=false
# Comma-separated clinic/service keys. Send as X-API-Key.
# API_KEYS=clinic-alpha-key,clinic-beta-key
# HMAC secret for signed trial tokens (X-Trial-Token).
# TRIAL_TOKEN_SECRET=change-me-to-a-long-random-string
# AUDIT_HASH_SALT=optional-override-for-ip-actor-hashes
# TRUST_X_FORWARDED_FOR=true

# Copy to web/backend/.env (or export in shell). Never commit real keys.

AUTH_REQUIRED=true
CAVIO_AUTH_SECRET=replace-with-long-random-string
ALLOW_LOCAL_AUTH=true
FIREBASE_PROJECT_ID=

MAX_UPLOAD_BYTES=20971520
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

SIGNUP_BONUS_CREDITS=3
SCAN_CREDIT_COST=1
CREDITS_PER_PACK=25
CREDIT_PACK_PRICE_CENTS=1999

# Stripe TEST mode only (sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=

CHECKOUT_SUCCESS_URL=http://localhost:5173/settings?credits=success
CHECKOUT_CANCEL_URL=http://localhost:5173/settings?credits=cancel

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

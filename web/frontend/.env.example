# Empty API base uses the Vite proxy to localhost:8000.
# For a remote backend, set the origin only (no trailing slash).
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_URL=http://localhost:8000

# Optional credentials forwarded to /api/analyze and /api/models.
# VITE_API_KEY=
# VITE_TRIAL_TOKEN=

# VITE_ENABLE_SOURCE_UPLOAD=false
